{
  "name": "@roxybrowser/codex-plugin",
  "version": "0.1.1",
  "description": "Codex plugin wrapper for the RoxyBrowser OpenAPI and Playwright MCP servers with OAuth bootstrap.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "roxybrowser-openapi-mcp": "./bin/roxybrowser-openapi-mcp",
