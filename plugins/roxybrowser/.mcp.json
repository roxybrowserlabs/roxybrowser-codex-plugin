{
  "mcpServers": {
    "roxybrowserOpenapi": {
      "command": "./bin/roxybrowser-openapi-mcp",
      "args": [],
      "cwd": ".",
      "env_vars": [
        "ROXY_API_HOST",
        "ROXY_API_KEY",
        "ROXY_WORKSPACE_ID",
        "ROXY_TIMEOUT",
        "ROXY_CODEX_CONFIG_PATH",
        "ROXY_CODEX_OAUTH_URL",
        "HOME",
        "USERPROFILE",
        "APPDATA",
        "LOCALAPPDATA",
        "PATH"
      ],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 3600
    },
    "roxybrowserPlaywright": {
      "command": "./bin/roxybrowser-playwright-mcp",
      "args": [],
      "cwd": ".",
      "env_vars": [
        "PLAYWRIGHT_MCP_OUTPUT_DIR",
        "PLAYWRIGHT_MCP_ALLOWED_HOSTS",
        "PLAYWRIGHT_MCP_ALLOWED_ORIGINS",
        "PLAYWRIGHT_MCP_BLOCKED_ORIGINS",
        "PLAYWRIGHT_MCP_CAPS",
        "PLAYWRIGHT_MCP_TIMEOUT_ACTION",
        "PLAYWRIGHT_MCP_TIMEOUT_NAVIGATION",
        "HOME",
        "USERPROFILE",
        "APPDATA",
        "LOCALAPPDATA",
        "PATH"
      ],
      "startup_timeout_sec": 30,
      "tool_timeout_sec": 3600
    }
  }
}
