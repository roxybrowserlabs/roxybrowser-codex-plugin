#!/usr/bin/env node
import { spawn } from "node:child_process";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";
import { bootstrapRoxyEnv } from "./lib/bootstrap-config.mjs";

async function main() {
  try {
    const args = process.argv.slice(2);
    if (!isCredentialFreeCommand(args)) {
      await bootstrapRoxyEnv(process.env);
    }

    const root = resolve(dirname(fileURLToPath(import.meta.url)), "..");
    const launcher = join(root, "bin/lib/openapi-launcher.mjs");
    const childArgs = [
      "-y",
      "--package",
      "@roxybrowser/openapi@3.1.0",
      "node",
      launcher,
      ...args,
    ];
    const code = await new Promise((resolvePromise, rejectPromise) => {
      const child = spawn(
        "npx",
        childArgs,
        {
          cwd: root,
          env: process.env,
          stdio: "inherit",
        },
      );

      child.on("error", rejectPromise);
      child.on("close", (exitCode) => resolvePromise(exitCode ?? 1));
    });

    process.exitCode = code;
  } catch (error) {
    console.error(error instanceof Error ? error.message : String(error));
    process.exitCode = 1;
  }
}

function isCredentialFreeCommand(args) {
  return args.includes("--help")
    || args.includes("-h")
    || args[0] === "help"
    || args[0] === "version"
    || args[0] === "supports";
}

await main();
